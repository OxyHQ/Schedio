{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!.worktrees",
      "!**/dist",
      "!**/coverage",
      "!**/.expo",
      "!**/.next",
      "!**/drizzle/meta",
      "!**/*.generated.*",
      "!packages/backend/drizzle",
      "!packages/contracts/openapi.json",
      "!packages/frontend/assets/lottie"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              { "name": "useSharedValue", "stableResult": true },
              { "name": "useAnimatedRef", "stableResult": true }
            ]
          }
        },
        "useHookAtTopLevel": "error",
        "noUnresolvedImports": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noVar": "error",
        "useIterableCallbackReturn": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/frontend/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@oxy.so/services": "The root entry registers every Oxy account screen at import, which puts them in first paint. Import from '@oxy.so/services/ui/client' (or a type from '@oxy.so/services/ui')."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/frontend/**/*.js",
        "packages/frontend/**/*.jsx",
        "packages/frontend/**/*.cjs",
        "packages/frontend/**/*.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    }
  ]
}
