{
  "name": "schedio",
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Schedio Monorepo - Frontend and Backend",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter '@schedio/frontend' dev",
    "dev:backend": "bun run --filter '@schedio/backend' dev",
    "build": "bun run --filter '*' build",
    "build:shared-types": "bun run --filter '@schedio/shared-types' build",
    "build:frontend": "bun run build:publishing && bun run --filter @schedio/frontend build",
    "build:backend": "bun run build:publishing && bun run --filter @schedio/backend build",
    "test": "bun run --filter '*' test",
    "lint": "biome check --error-on-warnings . && bun run --filter '@schedio/frontend' lint:expo",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:bun-pin": "bun scripts/check-bun-pin.mjs",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --filter '@schedio/frontend' start",
    "start:backend": "bun run --filter '@schedio/backend' start",
    "web": "bun run --filter '@schedio/frontend' web",
    "postinstall": "bun run build:shared-types && bun run build:publishing",
    "build:publishing": "bun run --filter @schedio/contracts build && bun run --filter @schedio/sdk build",
    "check:openapi": "bun scripts/openapi.ts",
    "generate:openapi": "bun scripts/openapi.ts --write",
    "check:publishing-artifacts": "bun scripts/check-publishing-artifacts.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^20.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "24.20.0"
  },
  "dependencies": {
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/core": "6.0.0",
    "@oxy.so/services": "^12.2.0",
    "@react-native/js-polyfills": "^0.88.0",
    "react-native-worklets": "0.13.0",
    "react-native-worklets-core": "^1.6.3"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "react-native-svg": "15.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-babel-transformer": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@oxy.so/core": "6.0.0",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/telemetry": "^2.1.0",
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/services": "^12.2.0",
    "react-native-css": "3.1.0-rc.0",
    "react-native-worklets": "0.13.0",
    "markdown-it": "12.3.2",
    "@oxy.so/mention-contracts": "0.1.3",
    "@oxy.so/protocol": "1.4.1"
  },
  "resolutions": {
    "@oxy.so/telemetry": "^2.1.0",
    "react-native-css": "3.1.0-rc.0"
  }
}
