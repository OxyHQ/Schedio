{
  "name": "@schedio/backend",
  "version": "1.0.0",
  "private": true,
  "author": "",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude 'dist/**'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only src/db/migrate.ts",
    "db:build-import-manifest": "ts-node --transpile-only src/db/buildLegacyManifest.ts",
    "db:import-legacy": "ts-node --transpile-only src/db/importLegacyJsonl.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oxy.so/core": "1.1.0",
    "@oxy.so/db": "1.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.1",
    "express-slow-down": "^2.1.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "drizzle-kit": "0.31.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
