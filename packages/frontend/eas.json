{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "extends": "production",
      "distribution": "internal"
    },
    "production": {
      "node": "24.20.0",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "staging": {
      "extends": "production",
      "distribution": "internal"
    }
  }
}
